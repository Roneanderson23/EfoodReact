{
    "env": {
        "browser": true,
        "es2021": true
    },
    "extends": [
        "eslint:recommended",
        "plugin:@typescript-eslint/recommended",
        "plugin:react/recommended",
        "plugin:prettier/recommended"
    ],
    "parser": "@typescript-eslint/parser",
    "parserOptions": {
        "ecmaVersion": "latest",
        "sourceType": "module"
    },
    "plugins": [
        "react",
        "@typescript-eslint",
        "react-hooks"
    ],
    "rules": {
        "react-hooks/rules-of-hooks": "error", // Verificar regras de ganchos
        "react-hooks/exhaustive-deps": "warn", // Verifica dependências de efeitos
        "react/prop-types": "off",
        "react/react-in-jsx-scope": "off", // quando esta ligando obriga importar react 
        "@typescript-eslint/explicit-module-boundary-types":"off" // não precisa explicitar retorno de funçoes
    },
    "settings": {
        "react": {
            "version": "detect"
        }
    }
}
